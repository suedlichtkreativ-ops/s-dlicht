---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { scenes, site } from '../data/work';
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <Image src={logo} alt="" height={112} loading="lazy" />
        <p class="body-l" style="max-width:24em">Aftermovies, Eventfotografie, Motion Design und KI-Spots. Aus Kaufbeuren, unterwegs zwischen Allgäu und Ulm.</p>
      </div>
      <div>
        <h2>Kontakt</h2>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={`tel:${site.phoneHref}`}>{site.phone}</a></li>
          <li class="muted" style="padding-top:4px">{site.street}<br />{site.zip} {site.city}</li>
        </ul>
      </div>
      <div>
        <h2>Szenen</h2>
        <ul>
          {scenes.map((s) => <li><a href={`/arbeiten/?szene=${s.id}`}>{s.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Seiten</h2>
        <ul>
          <li><a href="/leistungen/">Leistungen</a></li>
          <li><a href="/ueber/">Über mich</a></li>
          <li><a href="/kontakt/">Kontakt</a></li>
          <li><a href="/impressum/">Impressum</a></li>
          <li><a href="/datenschutz/">Datenschutz</a></li>
          <li><a href="/ki-hinweis/">Hinweis zu KI</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="gradbar" data-bar aria-hidden="true"></div>
  <div class="wrap foot-bar">
    <span>© {year} {site.name}, {site.city}</span>
    <span>KI-Arbeiten sind immer gekennzeichnet.</span>
  </div>
</footer>
