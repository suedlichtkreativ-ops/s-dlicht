---
import { Picture } from 'astro:assets';
import type { Project } from '../data/work';
import { projectHasAi, sceneLabel } from '../data/work';
import { pic, pickWidths } from '../data/img';
import Arrow from './Arrow.astro';

interface Props { projects: Project[] }
const { projects } = Astro.props;
---
<ul class="index">
  {projects.map((p) => (
    <li data-reveal>
      <a href={`/arbeiten/${p.slug}/`}>
        <span class="thumb" aria-hidden="true">
          <Picture src={p.cover} alt="" {...pic} widths={pickWidths([200])} sizes="96px" loading="lazy" />
        </span>
        <span>
          <span class="t">{p.title}</span>
          {projectHasAi(p) && <span class="meta ki ki-mark">KI</span>}
        </span>
        <span class="meta-r meta">{sceneLabel(p)} · {p.kind}</span>
        <span class="arr" aria-hidden="true"><Arrow /></span>
      </a>
    </li>
  ))}
</ul>
