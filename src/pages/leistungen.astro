---
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import Arrow from '../components/Arrow.astro';
import { services } from '../data/services';
import { projects } from '../data/work';

const pick = (slug: string, n = 0) => projects.find((p) => p.slug === slug)!.items[n];
const visuals = [pick('tanzlauter-am-turm', 1), pick('sp-prints', 1), pick('relight', 0), pick('muay-thai-gala', 0)];
const alts = ['Tanzlauter am Turm, Aftermovie', 'SP Prints, Spot mit Sprecher', 'Relight, mit KI neu belichtet', 'Muay Thai Gala, Schlagabtausch im Ring'];
const steps = [
  ['Anfrage', 'Du schreibst mir kurz, was du planst, wann und wo.'],
  ['Telefonat', 'Wir klären Umfang, Formate und was am Ende rauskommen soll.'],
  ['Dreh', 'Ich komme mit Kamera, Gimbal und Drohne zum Event oder Shooting.'],
  ['Schnitt', 'Schnitt, Farbe und Grafik laufen remote aus Kaufbeuren.'],
  ['Lieferung', 'Du bekommst die fertigen Clips und Fotos für deine Kanäle.'],
];
const tools = ['Premiere Pro', 'After Effects', 'Photoshop', 'Illustrator', 'Lightroom', 'DaVinci Resolve', 'Higgsfield', 'Kling'];
const gear = ['Sony A7 III', 'Drohne', 'Gimbal'];
---
<Base title="Leistungen" description="Aftermovies und Reels, Motion und Grafik, KI-Spots und Fotografie vor Ort. Südlicht Studio aus Kaufbeuren, im Allgäu und bis Ulm unterwegs.">
  <header class="page-head wrap">
    <h1 class="display" data-split>Leistungen</h1>
    <p class="lead" data-reveal>Vom Dreh bis zum fertigen Reel. Zum Event komme ich mit Kamera und Drohne, Schnitt und Grafik laufen remote.</p>
  </header>

  {services.map((s, i) => (
    <section class="wrap svc-row" aria-labelledby={`svc-${i}`}>
      <div class="split" style="align-items:start">
        <div style="display:grid;gap:20px;align-content:start">
          <h2 id={`svc-${i}`} class="display h3" data-split>{s.title}</h2>
          <p class="body-l" data-reveal>{s.text}</p>
          <dl data-reveal>
            {s.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </div>
        <Media item={visuals[i]} alt={alts[i]} sizes="(max-width: 860px) 100vw, 60vw" ratio={i % 2 ? '4/5' : '16/10'} />
      </div>
    </section>
  ))}

  <section class="wrap section" aria-labelledby="steps-title">
    <h2 id="steps-title" class="display h2" data-split style="margin-bottom:clamp(40px,6vw,72px)">So läuft ein Projekt.</h2>
    <ol class="steps">
      {steps.map(([t, d]) => <li data-reveal><h3>{t}</h3><p>{d}</p></li>)}
    </ol>
  </section>

  <section class="wrap" style="padding-bottom:clamp(80px,10vw,140px)" aria-labelledby="tools-title">
    <h2 id="tools-title" class="display h3" data-split style="margin-bottom:24px">Werkzeug</h2>
    <ul class="tools" data-reveal>{tools.map((t) => <li>{t}</li>)}</ul>
    <ul class="tools gear" data-reveal style="margin-top:10px">{gear.map((t) => <li>{t}</li>)}</ul>
  </section>

  <section class="wrap" style="padding-bottom:clamp(64px,8vw,120px)" aria-labelledby="cta-title">
    <div class="p-cta" data-reveal>
      <div>
        <h2 id="cta-title">Lass uns reden.</h2>
        <p>Schreib mir kurz, was du planst, wann und wo. Den Rest klären wir am Telefon.</p>
      </div>
      <a class="btn" href="/kontakt/">Projekt anfragen <Arrow /></a>
    </div>
  </section>
</Base>
