---
import Base from '../../layouts/Base.astro';
---
<Base title="Danke" description="Deine Anfrage ist angekommen." noindex>
  <header class="page-head wrap" style="min-height:70svh">
    <span class="mono label">Anfrage gesendet</span>
    <h1 class="display" data-split style="margin-top:20px">Danke!</h1>
    <div class="page-head-row">
      <p class="lead" data-reveal>Deine Anfrage ist angekommen. Ich melde mich bei dir.</p>
    </div>
    <p style="margin-top:40px" data-reveal><a class="btn" href="/arbeiten/">Solange Arbeiten ansehen <span class="arr" aria-hidden="true">↗</span></a></p>
  </header>
</Base>
