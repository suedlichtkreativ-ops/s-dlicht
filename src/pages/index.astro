---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Arrow from '../components/Arrow.astro';
import { clientSlug, clients, projectsByScene, sceneReel, scenes, site } from '../data/work';
import { services } from '../data/services';
import { pic, pickWidths } from '../data/img';
import portrait from '../assets/portrait.jpg';
import closerImg from '../assets/work/31_muay_thai_gala.jpg';

// Monitor: ein Hochformat-Clip je Szene. Kanal-Vorschau: Standbild des Clips.
const reels = await Promise.all(
  scenes.map(async (s) => {
    const r = sceneReel(s.id);
    const [posterImg, thumb] = await Promise.all([
      getImage({ src: r.poster, width: 720, format: 'webp' }),
      getImage({ src: r.poster, width: 160, format: 'webp' }),
    ]);
    return { scene: s, src: r.src, poster: posterImg.src, thumb: thumb.src };
  }),
);
const first = scenes[0];
---
<Base
  title={site.name}
  description="Alexander Malkevich filmt und fotografiert Open Airs, Clubnächte und Fight Nights, macht Fotos für Gastro und Marken und baut KI-Spots. Südlicht Studio, Kaufbeuren."
>
  <section class="mixer wrap" aria-labelledby="hero-title" data-mixer data-scene="club">
    <div class="mixer-grid">
      <div class="mixer-copy">
        <h1 id="hero-title" class="display mixer-h1"><span class="l">Film, Foto</span> <span class="l">und KI&#8209;Spots</span> <em class="l">aus der Szene.</em></h1>
        <p class="lead" data-reveal>Ich filme Open Airs, Clubnächte und Fight Nights, fotografiere für Gastro und Marken und baue KI-Spots. Geschnitten fürs Hochformat, damit man im Feed hängen bleibt.</p>
        <div class="btn-row" data-reveal>
          <a class="btn primary" href="/kontakt/" data-scene-link="kontakt">Projekt anfragen <Arrow /></a>
          <a class="btn" href="/arbeiten/">Alle Arbeiten</a>
        </div>
      </div>

      <div class="monitor" data-monitor aria-label="Clip der gewählten Szene">
        {reels.map((r, i) => (
          <video
            class:list={[{ 'is-on': i === 0 }]}
            muted
            playsinline
            loop
            preload={i === 0 ? 'metadata' : 'none'}
            poster={r.poster}
            data-reel-src={r.src}
            data-scene={r.scene.id}
            width="720"
            height="1280"
            aria-hidden="true"
          ></video>
        ))}
        <div class="monitor-bar">
          <span class="tally" data-tally>{first.label}</span>
          <button class="monitor-ctl" type="button" data-monitor-toggle aria-label="Video pausieren" aria-pressed="false">
            <svg data-icon="pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <svg data-icon="play" viewBox="0 0 16 16" aria-hidden="true" hidden><path d="M5 3l8 5-8 5z" fill="currentColor"/></svg>
          </button>
        </div>
      </div>

      <div class="channels" role="group" aria-label="Szene wählen">
        <p class="channels-h">Wähle deine Szene</p>
        {reels.map((r, i) => (
          <button class="channel" type="button" data-channel={r.scene.id} data-label={r.scene.label} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`szene-${r.scene.id}`}>
            <span class="channel-thumb" aria-hidden="true"><img src={r.thumb} alt="" width="160" height="284" loading="lazy" decoding="async" /></span>
            <span>
              <span class="channel-name">{r.scene.short}</span>
              <span class="channel-line">{r.scene.line}</span>
            </span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="wrap" style="padding-block:clamp(40px,6vw,88px) clamp(80px,10vw,140px)" aria-label="Arbeiten nach Szene">
    {scenes.map((s, i) => {
      const list = projectsByScene(s.id);
      return (
        <div class="scene-panel" id={`szene-${s.id}`} data-panel={s.id}>
          <div class="head-row">
            <h2 class="display h2">{s.headline}</h2>
            <a class="link-arrow" href={`/arbeiten/?szene=${s.id}`}>Alle Arbeiten: {s.label} <Arrow /></a>
          </div>
          <div class="pgrid">
            {list.slice(0, 3).map((p) => <ProjectCard project={p} />)}
            <div class:list={['cta-card', { 'span-2': list.slice(0, 3).length === 2 }]}>
              <h3>{s.cta}</h3>
              <div style="display:grid;gap:18px">
                <p>Schreib mir kurz, was du planst, wann und wo. Den Rest klären wir am Telefon.</p>
                <a class="btn" href={`/kontakt/?szene=${s.id}`}>Projekt anfragen <Arrow /></a>
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </section>

  <section class="wrap" style="padding-bottom:clamp(80px,11vw,160px)" aria-labelledby="clients-title">
    <h2 id="clients-title" class="lead" style="margin-bottom:24px;color:var(--muted)">Zuletzt gearbeitet für</h2>
    <ul class="clients">
      {clients.map((c) => (
        <li data-reveal>{clientSlug[c] ? <a href={`/arbeiten/${clientSlug[c]}/`}>{c}</a> : c}</li>
      ))}
    </ul>
  </section>

  <section class="wrap section" style="padding-top:0" aria-labelledby="svc-title">
    <div class="head-row">
      <h2 id="svc-title" class="display h2" data-split>Vom Dreh bis zum Reel.</h2>
      <p class="body-l" data-reveal>Zum Event komme ich mit Kamera, Gimbal und Drohne. Schnitt und Grafik laufen remote. Du bekommst fertige Clips und Fotos für deine Kanäle.</p>
    </div>
    <div class="svc-grid">
      {services.map((s) => (
        <article class="svc" data-reveal>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <dl>
            {s.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </article>
      ))}
    </div>
    <p style="margin-top:32px"><a class="link-arrow" href="/leistungen/">Mehr zu den Leistungen und zum Ablauf <Arrow /></a></p>
  </section>

  <section class="wrap" style="padding-bottom:clamp(80px,11vw,160px)" aria-labelledby="about-title">
    <div class="about">
      <div class="portrait" data-relight>
        <Picture src={portrait} alt="Portrait von Alexander Malkevich" {...pic} widths={pickWidths([480, 800, 1000])} sizes="(max-width: 860px) 100vw, 40vw" loading="lazy" />
      </div>
      <div style="display:grid;gap:24px">
        <h2 id="about-title" class="display h2" data-split>Hi, ich bin Alex.</h2>
        <p class="lead" data-reveal>Angefangen hab ich mit der Kamera am Ring und im Club. Da lernt man schnell, dass der gute Moment genau einmal passiert.</p>
        <p class="body-l" data-reveal>Heute schneide ich Aftermovies, animiere Logos und Announcements und baue mit KI Werbespots, für die es sonst ein Filmteam bräuchte.</p>
        <p data-reveal><a class="link-arrow" href="/ueber/">Mehr über mich <Arrow /></a></p>
      </div>
    </div>
  </section>

  <section class="closer" aria-labelledby="closer-title">
    <div class="closer-bg" aria-hidden="true">
      <Picture src={closerImg} alt="" {...pic} widths={pickWidths([800, 1600])} sizes="100vw" loading="lazy" />
    </div>
    <div class="wrap">
      <h2 id="closer-title" class="display" data-split>Nächstes Event?</h2>
      <p class="lead" data-reveal>Schreib mir kurz, was du planst, wann und wo. Den Rest klären wir am Telefon.</p>
      <div class="btn-row" data-reveal>
        <a class="btn primary" href="/kontakt/" data-scene-link="kontakt">Projekt anfragen <Arrow /></a>
        <a class="btn" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
