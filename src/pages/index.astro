---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Media from '../components/Media.astro';
import ProjectIndex from '../components/ProjectIndex.astro';
import { clients, featured, heroReels, projects, site } from '../data/work';
import { services } from '../data/services';
import portrait from '../assets/portrait.jpg';

const reelPosters = await Promise.all(heroReels.map((r) => getImage({ src: r.poster, width: 540, format: 'webp' })));
const byCaption = (slug: string, caption: string) => projects.find((p) => p.slug === slug)!.items.find((i) => i.caption === caption)!;
const showcase = [
  { item: byCaption('loca-noche', 'Mitten in der Crowd'), alt: 'Loca Noche, mitten in der Crowd', title: 'Loca Noche' },
  { item: byCaption('automobile-schall', 'Car Edit mit KI Effekten'), alt: 'Automobile Schall, Car Edit mit KI Effekten', title: 'Automobile Schall' },
  { item: byCaption('vima-essbar', 'Siebträger im Gegenlicht'), alt: 'VIMA ESSBAR, Siebträger im Gegenlicht', title: 'VIMA ESSBAR' },
];
const word = 'Südlicht'.split('');
---
<Base
  title={site.name}
  description="Alexander Malkevich filmt und fotografiert Open Airs, Clubnächte und Fight Nights und schneidet daraus Content für Instagram und TikTok. Südlicht Studio, Kaufbeuren."
>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-stage">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="hero-grid" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

      <div class="hero-copy">
        <span class="mono label">Film · Foto · Motion · KI — Kaufbeuren</span>
        <p class="lead">Ich filme und fotografiere Open Airs, Clubnächte und Fight Nights. Daraus schneide ich Content, bei dem man auf Instagram und TikTok hängen bleibt.</p>
        <div style="display:flex;gap:12px;flex-wrap:wrap">
          <a class="btn primary" href="/arbeiten/">Arbeiten ansehen <span class="arr" aria-hidden="true">↗</span></a>
          <a class="btn" href="/kontakt/">Projekt anfragen</a>
        </div>
      </div>

      <div class="reel" data-reel aria-label="Showreel: Ausschnitte aus Aftermovies" role="img">
        {heroReels.map((r, i) => (
          <video muted playsinline preload={i === 0 ? 'auto' : 'none'} poster={reelPosters[i].src} data-reel-src={r.src} width="720" height="1280" aria-hidden="true"></video>
        ))}
        <div class="reel-meta mono" aria-hidden="true"><span class="rec">Rec</span><span data-reel-label>01 / 03</span></div>
      </div>

      <h1 id="hero-title" class="display hero-word" aria-label="Südlicht Studio">
        {word.map((c) => <span class="ch" aria-hidden="true">{c}</span>)}
      </h1>

      <div class="hero-foot mono muted">
        <a class="hero-mail link-u" href={`mailto:${site.email}`}>{site.email}</a>
        <span class="scroll-cue" aria-hidden="true"><i></i>Scroll</span>
        <span>Allgäu — Ulm</span>
      </div>
    </div>
  </section>

  <section class="wrap section" aria-labelledby="clients-title" style="padding-bottom:0">
    <div class="sec-head mono muted"><h2 id="clients-title" class="mono label" style="margin:0;font-weight:400">Zuletzt gearbeitet für</h2><span>{String(clients.length).padStart(2, '0')} Kunden</span></div>
    <ul class="clients">
      {clients.map((c) => <li data-reveal>{c}</li>)}
    </ul>
  </section>

  <section class="wrap section" aria-labelledby="work-title">
    <div class="sec-head mono muted"><span class="label">Ausgewählte Arbeiten</span><span>{String(featured.length).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</span></div>
    <div class="split" style="margin-bottom:clamp(40px,6vw,80px);align-items:end">
      <h2 id="work-title" class="display h2" data-split style="grid-column:1/-1">Der gute Moment passiert genau einmal.</h2>
    </div>
    <ProjectIndex projects={featured} />
    <p style="margin-top:40px"><a class="btn" href="/arbeiten/">Alle Arbeiten <span class="arr" aria-hidden="true">↗</span></a></p>
  </section>

  <section class="wrap" aria-label="Einblicke">
    <div class="p-gallery">
      {showcase.map((s, i) => (
        <figure class={i === 1 ? 'tall' : 'tall'} style="margin:0">
          <Media item={s.item} alt={s.alt} sizes="(max-width: 760px) 100vw, 33vw" ratio="4/5" />
          <figcaption class="tile-cap mono"><span>{s.title}</span><span>{s.item.caption}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="svc-title">
    <div class="sec-head mono muted"><span class="label">Leistungen</span><span>04</span></div>
    <div class="split" style="margin-bottom:clamp(40px,6vw,72px);align-items:end">
      <h2 id="svc-title" class="display h2" data-split style="grid-column:1/-1">Vom Dreh bis zum Reel.</h2>
      <p class="body-l" data-reveal>Zum Event komme ich mit Kamera und Drohne. Schnitt und Grafik laufen remote. Du bekommst fertige Clips, die im Feed funktionieren.</p>
    </div>
    <div class="svc-grid">
      {services.map((s, i) => (
        <article class="svc" data-reveal>
          <span class="mono n">({String(i + 1).padStart(2, '0')})</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <dl class="mono">
            {s.rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
          </dl>
        </article>
      ))}
    </div>
    <p style="margin-top:40px"><a class="btn" href="/leistungen/">Mehr zu den Leistungen <span class="arr" aria-hidden="true">↗</span></a></p>
  </section>

  <section class="wrap section" aria-labelledby="about-title" style="padding-top:0">
    <div class="sec-head mono muted"><span class="label">Über mich</span><span>Kaufbeuren</span></div>
    <div class="about">
      <div class="portrait" data-relight>
        <Picture src={portrait} alt="Portrait von Alexander Malkevich" formats={['avif', 'webp']} widths={[480, 800, 1000]} sizes="(max-width: 860px) 100vw, 40vw" loading="lazy" />
      </div>
      <div style="display:grid;gap:28px">
        <h2 id="about-title" class="display h2" data-split>Hi, ich bin Alex.</h2>
        <p class="lead" data-reveal>Angefangen hab ich mit der Kamera am Ring und im Club. Da lernt man schnell, dass der gute Moment genau einmal passiert.</p>
        <p class="body-l" data-reveal>Heute schneide ich Aftermovies, animiere Logos und Announcements und baue mit KI Werbespots, für die es sonst ein Filmteam bräuchte.</p>
        <p data-reveal><a class="btn" href="/ueber/">Mehr über mich <span class="arr" aria-hidden="true">↗</span></a></p>
      </div>
    </div>
  </section>

  <section class="cta" aria-labelledby="cta-title">
    <div class="wrap">
      <span class="mono label">Kontakt</span>
      <h2 id="cta-title" class="display" data-split style="margin:24px 0 32px">Nächstes Event?</h2>
      <div style="display:flex;gap:12px;flex-wrap:wrap" data-reveal>
        <a class="btn primary" href="/kontakt/">Projekt anfragen <span class="arr" aria-hidden="true">↗</span></a>
        <a class="btn" href={`tel:${site.phoneHref}`}>{site.phone}</a>
      </div>
    </div>
  </section>
</Base>
