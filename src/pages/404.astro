---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden" description="Diese Seite gibt es nicht." noindex>
  <header class="page-head wrap" style="min-height:80svh">
    <h1 class="display" data-split>Licht aus.</h1>
    <p class="lead" data-reveal>Diese Seite gibt es nicht, oder nicht mehr.</p>
    <p style="margin-top:40px;display:flex;gap:12px;flex-wrap:wrap" data-reveal>
      <a class="btn primary" href="/">Zur Startseite</a>
      <a class="btn" href="/arbeiten/">Arbeiten ansehen</a>
    </p>
  </header>
</Base>
