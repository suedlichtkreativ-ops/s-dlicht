---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Tile from '../../components/Tile.astro';
import Lightbox from '../../components/Lightbox.astro';
import Arrow from '../../components/Arrow.astro';
import { projectHasAi, projects, sceneById, type Project } from '../../data/work';
import { pic, pickWidths } from '../../data/img';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { project: p, next: projects[(i + 1) % projects.length] } }));
}
interface Props { project: Project; next: Project }
const { project: p, next } = Astro.props;
const scene = sceneById(p.scene);

// Galerie-Rhythmus: Querformat über die volle Breite; der Rest paarweise.
// Bleibt eine ungerade Zahl übrig, laufen drei nebeneinander, statt eine Kachel allein zu lassen.
type It = Project['items'][number];
const ratio = (it: It) => (it.type === 'img' ? it.image.width / it.image.height : it.w / it.h);
const isWide = (it: It) => ratio(it) > 1.2;
const narrow = p.items.filter((it) => !isWide(it));
const layoutOf = (it: It) => {
  if (isWide(it)) return 'wide';
  if (narrow.length === 1) return 'solo';
  if (narrow.length % 2 === 1 && narrow.indexOf(it) >= narrow.length - 3) return 'third';
  return '';
};
const sizesOf = (l: string) => (l === 'wide' ? '100vw' : l === 'third' ? '(max-width: 760px) 100vw, 33vw' : '(max-width: 760px) 100vw, 50vw');
---
<Base title={p.title} description={`${p.title}: ${p.intro}`}>
  <header class="page-head wrap">
    <a class="back" href="/arbeiten/"><Arrow dir="left" /> Alle Arbeiten</a>
    <h1 class="display" data-split>{p.title}</h1>
    <p class="lead" data-reveal>{p.intro}</p>
  </header>

  <section class="wrap" aria-label="Projektdaten">
    <dl class="p-meta" data-reveal>
      <div><dt>Szene</dt><dd><a class="link-u" href={`/arbeiten/?szene=${p.scene}`}>{scene.label}</a></dd></div>
      <div><dt>Art</dt><dd>{p.kind}{p.place ? `, ${p.place}` : ''}</dd></div>
      <div><dt>Leistung</dt><dd>{p.services.join(', ')}{projectHasAi(p) ? ' · mit KI, gekennzeichnet' : ''}</dd></div>
    </dl>
  </section>

  <section class="wrap" style="padding-block:clamp(32px,4vw,56px)" aria-label="Galerie">
    <div class="p-gallery">
      {p.items.map((it) => {
        const l = layoutOf(it);
        return <Tile item={it} project={p} class={l} sizes={sizesOf(l)} />;
      })}
    </div>
  </section>

  <section class="wrap" style="padding-bottom:clamp(64px,8vw,120px)" aria-labelledby="p-cta-title">
    <div class="p-cta" data-reveal>
      <div>
        <h2 id="p-cta-title">{scene.cta}</h2>
        <p>Schreib mir kurz, was du planst, wann und wo. Deine Szene ist im Formular schon ausgewählt.</p>
      </div>
      <a class="btn" href={`/kontakt/?szene=${p.scene}`}>Projekt anfragen <Arrow /></a>
    </div>
  </section>

  <a class="next" href={`/arbeiten/${next.slug}/`}>
    <span class="bgimg" aria-hidden="true">
      <Picture src={next.cover} alt="" {...pic} widths={pickWidths([800, 1600])} sizes="100vw" loading="lazy" />
    </span>
    <span class="wrap" style="display:block">
      <span class="next-k">Nächstes Projekt</span>
      <span class="display" style="display:block">{next.title}</span>
    </span>
  </a>

  <Lightbox />
  <script>
    import '../../scripts/gallery.ts';
  </script>
</Base>
